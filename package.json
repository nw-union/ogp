{
  "name": "ogp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "wrangler dev",
    "deploy:production": "wrangler deploy --env production",
    "fmt": "biome format --write .",
    "lint": "biome lint --write .",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "check": "bun run fmt && bun run lint && bun run typecheck",
    "typegen": "wrangler types"
  },
  "dependencies": {
    "@react-router/cloudflare": "^8.0.1",
    "@types/bun": "^1.3.3",
    "isbot": "^5.1.32",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@cloudflare/vite-plugin": "^1.42.3",
    "@react-router/dev": "^8.0.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.17",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.51.0"
  }
}
