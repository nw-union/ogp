{
  "name": "ogp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "wrangler dev",
    "deploy:production": "wrangler deploy --env production",
    "fmt": "biome format --write .",
    "lint": "biome lint --write .",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "check": "bun run fmt && bun run lint && bun run typecheck",
    "typegen": "wrangler types"
  },
  "dependencies": {
    "@react-router/cloudflare": "^8.2.0",
    "@types/bun": "^1.3.14",
    "isbot": "^5.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@react-router/dev": "^8.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
